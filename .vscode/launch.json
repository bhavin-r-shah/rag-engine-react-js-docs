{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chunker",
      "type": "debugpy",
      "request": "launch",
      "module": "react_docs_chunker.cli",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/python-src"
      }
    },
    {
      "name": "Indexer",
      "type": "debugpy",
      "request": "launch",
      "module": "react_docs_chunker.indexing.cli",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/python-src"
      }
    }
  ]
}
